{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "services": {
    "web": {
      "root": "apps/hyperlocalise-web",
      "framework": "nextjs",
      "buildCommand": "pnpm run db:migrate && pnpm build"
    },
    "go_svc": {
      "runtime": "container",
      "root": ".",
      "entrypoint": "Dockerfile.vercel",
      "routes": [
        {
          "src": "/api/go-svc/(.*)",
          "transforms": [
            {
              "type": "request.path",
              "op": "set",
              "args": "/$1"
            }
          ]
        }
      ]
    }
  },
  "rewrites": [
    {
      "source": "/api/go-svc/(.*)",
      "destination": {
        "service": "go_svc"
      }
    },
    {
      "source": "/(.*)",
      "destination": {
        "service": "web"
      }
    }
  ],
  "crons": [
    {
      "path": "/api/cron/github-repository-automation-dispatch",
      "schedule": "*/15 * * * *"
    },
    {
      "path": "/api/cron/sandbox-cleanup",
      "schedule": "0 3 * * *"
    },
    {
      "path": "/api/cron/snapshot-cleanup",
      "schedule": "0 4 * * *"
    },
    {
      "path": "/api/cron/issue-notification-digest",
      "schedule": "*/15 * * * *"
    }
  ]
}
